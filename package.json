{
  "name": "rf-coaching",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gen:landmask": "node scripts/gen-landmask.mjs",
    "db:migrate:local": "wrangler d1 migrations apply rf-coaching-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rf-coaching-db --remote",
    "deploy": "npm run build && wrangler d1 migrations apply rf-coaching-db --remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "hono": "^4.13.12",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.145.0"
  }
}
