# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riccardo?schema=public
REDIS_URL=redis://localhost:6379

# ─── OpenAI (agent orchestration + QC vision) ────────────────────────────────
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
# Must support image input: the QC agent sends real extracted frames.
OPENAI_VISION_MODEL=gpt-4.1

# ─── Higgsfield ──────────────────────────────────────────────────────────────
# Official format: KEY_ID:KEY_SECRET. Server-side only — never NEXT_PUBLIC_*.
HF_CREDENTIALS=
# Alternative split form (used only when HF_CREDENTIALS is unset):
# HF_API_KEY=
# HF_API_SECRET=
HF_BASE_URL=https://api.higgsfield.ai
HF_WEBHOOK_SECRET=
HF_POLL_INTERVAL_MS=5000
HF_MAX_POLL_MS=600000
# Optional: JSON file overriding the bundled model catalog (no redeploy needed).
# HF_CATALOG_PATH=/etc/riccardo/higgsfield-catalog.json
# Allow catalog entries not verified against the official SDK. Off by default.
# HF_ALLOW_UNVERIFIED_MODELS=false

# ─── Object storage (S3-compatible) ──────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=riccardo-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900

# ─── Quality control (ffmpeg must be installed on the worker host) ───────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
QC_FRAME_COUNT=4
QC_MIN_SCORE=0.75

# ─── Security ────────────────────────────────────────────────────────────────
AUTH_SECRET=
RATE_LIMIT_PER_MINUTE=60

# ─── Seed ────────────────────────────────────────────────────────────────────
SEED_USER_EMAIL=owner@riccardo.fitness
SEED_USER_PASSWORD=

# ─── Instagram publisher (Phase 2 — interface only in this phase) ────────────
IG_GRAPH_API_VERSION=v21.0
IG_USER_ID=
IG_ACCESS_TOKEN=
