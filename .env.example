# Copia questo file in .env e compila i valori.
PORT=4000

# Dati del mittente usati nelle email di rinnovo
PT_NOME="Riccardo Falconi"
PT_EMAIL="riccardo@esempio.it"

# SMTP (lascia vuoto per la modalita' bozza: le email finiscono in data/outbox/*.eml)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Password di accesso: lasciala vuota in locale, obbligatoria se pubblichi online
APP_PASSWORD=
APP_SECRET=

# Percorso dei dati (su macOS l'installer usa ~/Library/Application Support/FitManager)
# DB_FILE=
# BACKUP_DIR=
