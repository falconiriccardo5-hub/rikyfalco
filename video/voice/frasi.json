[
 {"n":1,"id":"p01","text":"Ti alleni da mesi"},
 {"n":2,"id":"p02","text":"ma non cambi?"},
 {"n":3,"id":"p03","text":"Stesso esercizio. Stesso peso."},
 {"n":4,"id":"p04","text":"Settimana dopo settimana."},
 {"n":5,"id":"p05","text":"I mesi passano velocissimi..."},
 {"n":6,"id":"p06","text":"e il tuo corpo resta identico."},
 {"n":7,"id":"p07","text":"Stesso peso."},
 {"n":8,"id":"p08","text":"Stessi esercizi."},
 {"n":9,"id":"p09","text":"Stesso stimolo."},
 {"n":10,"id":"p10","text":"Stimolo uguale, risultato uguale."},
 {"n":11,"id":"p11","text":"La soluzione ha un nome..."},
 {"n":12,"id":"p12","text":"Progressione."},
 {"n":13,"id":"p13","text":"Un passo alla volta."},
 {"n":14,"id":"p14","text":"Aumenta il carico,"},
 {"n":15,"id":"p15","text":"le ripetizioni,"},
 {"n":16,"id":"p16","text":"cura la tecnica,"},
 {"n":17,"id":"p17","text":"alza il volume,"},
 {"n":18,"id":"p18","text":"e recupera bene."},
 {"n":19,"id":"p19","text":"Settimana uno, settimana quattro, otto, dodici: cambia davvero."},
 {"n":20,"id":"p20","text":"Allenarsi tanto non significa automaticamente allenarsi bene."}
]
