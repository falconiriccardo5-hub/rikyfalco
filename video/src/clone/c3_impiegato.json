{"dur": 53.688, "segs": [{"t0": 0.0, "t1": 3.3, "text": "Impiegato, 42 anni, ma al di schiena da 3 anni.", "words": [[0.0, 0.94, "Impiegato,"], [1.16, 1.54, "42"], [1.54, 1.92, "anni,"], [2.24, 2.36, "ma"], [2.36, 2.42, "al"], [2.42, 2.5, "di"], [2.5, 2.76, "schiena"], [2.76, 2.86, "da"], [2.86, 3.06, "3"], [3.06, 3.3, "anni."]]}, {"t0": 3.62, "t1": 5.76, "text": "Ecco come imposterei le sue prime 4 settimane.", "words": [[3.62, 3.84, "Ecco"], [3.84, 4.02, "come"], [4.02, 4.46, "imposterei"], [4.46, 4.6, "le"], [4.6, 4.72, "sue"], [4.72, 4.98, "prime"], [4.98, 5.18, "4"], [5.18, 5.76, "settimane."]]}, {"t0": 6.08, "t1": 9.66, "text": "È un caso tipo, non un cliente reale, ma è la storia che sento più spesso.", "words": [[6.08, 6.18, "È"], [6.18, 6.26, "un"], [6.26, 6.4, "caso"], [6.4, 6.74, "tipo,"], [7.0, 7.06, "non"], [7.06, 7.24, "un"], [7.24, 7.56, "cliente"], [7.56, 7.98, "reale,"], [8.2, 8.42, "ma"], [8.42, 8.48, "è"], [8.48, 8.56, "la"], [8.56, 8.8, "storia"], [8.8, 8.9, "che"], [8.9, 9.14, "sento"], [9.14, 9.26, "più"], [9.26, 9.66, "spesso."]]}, {"t0": 10.22, "t1": 14.54, "text": "8 ore in ufficio, 1 ora di macchina, palestra provata e mollata tre volte.", "words": [[10.22, 10.5, "8"], [10.5, 10.72, "ore"], [10.72, 10.84, "in"], [10.84, 11.28, "ufficio,"], [11.56, 11.72, "1"], [11.72, 11.84, "ora"], [11.84, 11.96, "di"], [11.96, 12.36, "macchina,"], [12.62, 12.92, "palestra"], [12.92, 13.46, "provata"], [13.46, 13.72, "e"], [13.72, 14.06, "mollata"], [14.06, 14.26, "tre"], [14.26, 14.54, "volte."]]}, {"t0": 15.06, "t1": 18.24, "text": "Sempre dopo 2 settimane. Il problema non era la voglia.", "words": [[15.06, 15.34, "Sempre"], [15.34, 15.6, "dopo"], [15.6, 15.8, "2"], [15.8, 16.24, "settimane."], [16.74, 16.86, "Il"], [16.86, 17.18, "problema"], [17.18, 17.56, "non"], [17.56, 17.76, "era"], [17.76, 17.9, "la"], [17.9, 18.24, "voglia."]]}, {"t0": 18.64, "t1": 24.42, "text": "Era il programma 6 esercizi presi a caso, carichi scelti a sensazione e nessun gior