{"dur": 51.44, "segs": [{"t0": 0.0, "t1": 4.08, "text": "Fai hip thrust e senti tutto nella schiena e quasi niente nei glutei?", "words": [[0.0, 0.5, "Fai"], [0.5, 0.76, "hip"], [0.76, 1.1, "thrust"], [1.1, 1.46, "e"], [1.46, 1.72, "senti"], [1.72, 1.88, "tutto"], [1.88, 2.18, "nella"], [2.18, 2.68, "schiena"], [2.68, 2.88, "e"], [2.88, 3.18, "quasi"], [3.18, 3.46, "niente"], [3.46, 3.66, "nei"], [3.66, 4.08, "glutei?"]]}, {"t0": 4.6, "t1": 7.12, "text": "Allora c 'è un errore, spesso è sempre lo stesso.", "words": [[4.6, 4.9, "Allora"], [4.9, 5.02, "c"], [5.02, 5.06, "'è"], [5.06, 5.16, "un"], [5.16, 5.5, "errore,"], [5.84, 6.26, "spesso"], [6.26, 6.5, "è"], [6.5, 6.7, "sempre"], [6.7, 6.84, "lo"], [6.84, 7.12, "stesso."]]}, {"t0": 7.68, "t1": 10.74, "text": "In alto in archi la schiena, invece di spingere con il bacino.", "words": [[7.68, 7.78, "In"], [7.78, 8.06, "alto"], [8.06, 8.4, "in"], [8.4, 8.66, "archi"], [8.66, 8.76, "la"], [8.76, 9.26, "schiena,"], [9.36, 9.56, "invece"], [9.56, 9.74, "di"], [9.74, 10.08, "spingere"], [10.08, 10.24, "con"], [10.24, 10.36, "il"], [10.36, 10.74, "bacino."]]}, {"t0": 11.22, "t1": 14.46, "text": "Quando arrivi su, le costole si aprono e lavora la zona lombare.", "words": [[11.22, 11.4, "Quando"], [11.4, 11.72, "arrivi"], [11.72, 11.96, "su,"], [12.28, 12.38, "le"], [12.38, 12.72, "costole"], [12.72, 12.9, "si"], [12.9, 13.24, "aprono"], [13.24, 13.44, "e"], [13.44, 13.68, "lavora"], [13.68, 13.82, "la"], [13.82, 14.0, "zona"], [14.0, 14.46, "lombare."]]}, {"t0": 14.92, "t1": 18.6, "text": "Il gluteo resta a metà, porta il mento leggermente verso il petto.", "words": [[14.92, 15.04, "Il"], [15.04, 15.44, "gluteo"], [15.44, 15.72, "resta"], [15.72, 15.8, "a"], [15.8, 16.1, "metà,"], [16.54, 16.78, "porta"], [16.78, 16.96, "il"], [16.96, 17.2, "mento"], [17.2, 17.72, "leggermente"], [17.72, 17.94, "verso"], [17.94, 18.18, "il"], [18.18, 18.6, "petto."]]}, {"t0": 18.84, "t1": 23.62, "text": "Tieni le costole giù e in alto chiudi il bacino, come se volessi portare il pub verso l 'unbellico.", "words": [[18.84, 18.96, "Tieni"], [18.96, 19.12, "le"], [19.12, 19.5, "costole"], [19.5, 19.78, "giù"], [19.78, 20.12, "e"], [20.12, 20.24, "in"], [20.24, 20.42, "alto"], [20.42, 20.68, "chiudi"], [20.68, 20.8, "il"], [20.8, 21.2, "bacino,"], [21.44, 21.6, "come"], [21.6, 21.72, "se"], [21.72, 22.02, "volessi"], [22.02, 22.42, "portare"], [22.42, 22.56, "il"], [22.56, 22.7, "pub"], [22.7, 23.0, "verso"], [23.0, 23.16, "l"], [23.16, 23.62, "'unbellico."]]}, {"t0": 23.92, "t1": 25.38, "text": "Li senti il gluteo che si accende.", "words": [[23.92, 24.06, "Li"], [24.06, 24.36, "senti"], [24.36, 24.44, "il"], [24.44, 24.76, "gluteo"], [24.76, 24.82, "che"], [24.82, 24.96, "si"], [24.96, 25.38, "accende."]]}, {"t0": 25.84, "t1": 27.62, "text": "Secondo dettaglio, i piedi.", "words": [[25.84, 26.2, "Secondo"], [26.2, 26.72, "dettaglio,"], [27.14, 27.28, "i"], [27.28, 27.62, "piedi."]]}, {"t0": 27.62, "t1": 31.62, "text": "Troppo lontani lavorano di più femorali, troppo vicini ai quadricipiti.", "words": [[27.62, 28.38, "Troppo"], [28.38, 28.86, "lontani"], [28.86, 29.3, "lavorano"], [29.3, 29.44, "di"], [29.44, 29.56, "più"], [29.56, 30.16, "femorali,"], [30.36, 30.56, "troppo"], [30.56, 30.92, "vicini"], [30.92, 31.02, "ai"], [31.02, 31.62, "quadricipiti."]]}, {"t0": 32.12, "t1": 34.38, "text": "In alto la tibia deve essere quasi verticale.", "words": [[32.12, 32.22, "In"], [32.22, 32.46, "alto"], [32.46, 32.72, "la"], [32.72, 32.98, "tibia"], [32.98, 33.1, "deve"], [33.1, 33.34, "essere"], [33.34, 33.62, "quasi"], [33.62, 34.38, "verticale."]]}, {"t0": 34.8, "t1": 36.08, "text": "Terzo, niente fretta.", "words": [[34.8, 35.12, "Terzo,"], [35.46, 35.66, "niente"], [35.66, 36.08, "fretta."]]}, {"t0": 36.5, "t1": 39.76, "text": "Sali in un secondo, fermati un secondo in alto, scendi in due.", "words": [[36.5, 36.8, "Sali"], [36.8, 36.86, "in"], [36.86, 36.94, "un"], [36.94, 37.3, "secondo,"], [37.76, 38.08, 